{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Copy Paste",
  "version": "2.9.0",
  "identifier": "VirtualCopyPaste",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Virtual Copy Paste",
        "width": 300,
        "height": 286,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost https://ipc.localhost tauri: https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Virtual Copy Paste",
    "shortDescription": "Virtual Copy Paste - Multi-Clipboard Manager",
    "longDescription": "A lightweight multi-clipboard manager that lets you copy multiple items and paste them selectively using Ctrl+Shift+V.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNjEyRDVDOUU2NTJCMTgKUldRWUsyV2VYQzFoYkt4R1ZCYlh6QlQ4VlJXMVE4a0RUNzRyUWtwMFJUR21UNFRzSjlxbWpCczMK",
      "endpoints": [
        "https://github.com/tomcek42/VirtualCopyPaste/releases/latest/download/latest.json"
      ]
    }
  }
}